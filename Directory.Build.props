<Project>

  <PropertyGroup>
    <!--
      The server version this plugin is built against. Jellyfin's plugin ABI is simply the
      server's AssemblyVersion (SharedVersion.cs -> "12.1.0"), which the plugin manifest
      repeats as `targetAbi`. Bumping it is the ONLY thing that makes the plugin load on a
      new server version, so it lives in exactly one place and every project reads it.
    -->
    <JellyfinVersion>12.1.0</JellyfinVersion>

    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>

</Project>
