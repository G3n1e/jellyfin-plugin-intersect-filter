<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Jellyfin.Plugin.BetterFiltering</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.BetterFiltering</RootNamespace>
    <Version>0.1.0.0</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <!--
    TargetFramework, Nullable and the JellyfinVersion used below are shared with the test
    project and live in the repository root's Directory.Build.props.
  -->

  <ItemGroup>
    <!--
      The client script is embedded rather than copied next to the DLL. An installed plugin
      folder is replaced wholesale, and the deploy script sweeps only *.dll and *.json, so a
      loose .js file would survive an upgrade and go stale against the server it ships with.
    -->
    <EmbeddedResource Include="Client/intersect-client.js" />
    <!--
      The settings page is embedded for the same reason the client script is: the host
      serves it out of the assembly, addressed by the resource name built in Plugin.GetPages,
      so a loose file next to the DLL would never be found.
    -->
    <EmbeddedResource Include="Configuration/configPage.html" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ExcludeAssets="runtime" is deliberate and important: these assemblies are
      supplied by the host server. Copying them into the plugin folder would let
      a stale Jellyfin.Controller.dll shadow the server's own, which produces
      confusing TypeLoadExceptions at load time.
    -->
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Data" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!--
      User and SortOrder live in Jellyfin.Database.Implementations, but there is no
      Jellyfin.Database package on nuget.org: it arrives transitively through
      Jellyfin.Controller, so it is not referenced explicitly here.
    -->
    <PackageReference Include="Jellyfin.Extensions" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
